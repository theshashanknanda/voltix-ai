// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ──────────────────────────────────────────
// USER — stub only. Full model owned by auth teammate.
// They will add: password_hash, createdAt, sessions, etc.
// ──────────────────────────────────────────
model User {
  id           String     @id @default(uuid())
  email        String     @unique
  name         String?
  passwordHash String
  createdAt    DateTime   @default(now())
  analyses     Analysis[]

  @@map("users")
}

// ──────────────────────────────────────────
// ANALYSIS — core of Issue #43
// Stores the uploaded filename + AI explanation.
// userId is nullable until auth is wired up.
// ──────────────────────────────────────────
model Analysis {
  id            String   @id @default(uuid())
  repositoryUrl String
  explanation   String   // AI-generated markdown text
  createdAt     DateTime @default(now())

  // Loose end for auth teammate — fill in userId once auth is done
  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@map("analyses")
}
